# Sao chép thành `.env` (cùng thư mục) rồi điền. File .env KHÔNG commit (đã gitignore).
# Lấy ở Supabase Dashboard → Project Settings → API.
#
# CHỈ hai giá trị này. Tuyệt đối không đặt khoá quản trị (service role) hay khoá SePay ở đây —
# mọi thứ trong file này đều bị nhúng vào bản build app, giải nén ra là đọc được.
EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
